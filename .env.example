# 应用基础配置
DATABASE_URL=sqlite+aiosqlite:///./data/zhidao.db
DB_ECHO=false

# 身份认证（必填；每个环境都应生成独立随机值）
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 文本模型（兼容 OpenAI 协议的 DeepSeek API）
DEEPSEEK_APIKEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 视觉模型（兼容 OpenAI 协议的 API）
VISION_APIKEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-flash

# 对话附件
CHAT_UPLOAD_DIR=./data/uploads/chat
CHAT_ATTACHMENT_MAX_BYTES=10485760

# 知识库与 Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_BASE_COLLECTION=kaoyan_full_knowledge
KNOWLEDGE_UPLOAD_DIR=./data/uploads/knowledge
KNOWLEDGE_PDF_MAX_BYTES=10485760
KNOWLEDGE_PDF_MAX_FILES=5
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KNOWLEDGE_EMBEDDING_DIMENSION=512
KNOWLEDGE_EMBEDDING_DEVICE=auto

# Redis 与邮箱验证码
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
EMAIL_CODE_EXPIRE_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# SMTP（注册和邮箱验证码登录必需）
SMTP_USER=
SMTP_KEY=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_FROM_NAME=至道
